        // ==================== レイキャスト ====================
        var raycaster = new THREE.Raycaster();
        raycaster.far = 5;
        
        function getTargetBlock() {
            raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
            
            var meshArray = [];
            for (var key in meshes) {
                meshArray.push(meshes[key]);
            }
            
            var intersects = raycaster.intersectObjects(meshArray, false);
            
            for (var i = 0; i < intersects.length; i++) {
                var obj = intersects[i].object;
                
                if (obj.userData && obj.userData.type !== undefined) {
                    if (obj.userData.type === BLOCKS.WATER) continue;
                    
                    return {
                        position: { x: obj.userData.x, y: obj.userData.y, z: obj.userData.z },
                        normal: intersects[i].face.normal,
                        type: obj.userData.type
                    };
                }
            }
            
            return null;
        }
        
        // ==================== ブロック操作 ====================
        function breakBlock() {
            var target = getTargetBlock();
            if (!target) return;
            
            var x = target.position.x;
            var y = target.position.y;
            var z = target.position.z;
            var type = target.type;
            
            if (y === 0) return;
            
            createBreakParticles(x, y, z, type);
            playBreakSound(type);
            
            setBlock(x, y, z, BLOCKS.AIR);
            updateBlockMesh(x, y, z);
        }
        
        function placeBlock() {
            var target = getTargetBlock();
            if (!target) return;
            
            var blockType = HOTBAR_ITEMS[selectedSlot];
            
            var newX = target.position.x + Math.round(target.normal.x);
            var newY = target.position.y + Math.round(target.normal.y);
            var newZ = target.position.z + Math.round(target.normal.z);
            
            if (newX < 0 || newX >= WORLD_SIZE_X || newY < 0 || newY >= WORLD_SIZE_Y || newZ < 0 || newZ >= WORLD_SIZE_Z) return;
            
            var playerX = Math.floor(camera.position.x);
            var playerY = Math.floor(camera.position.y - 1.5);
            var playerZ = Math.floor(camera.position.z);
            
            if ((newX === playerX && newZ === playerZ) && (newY === playerY || newY === playerY + 1)) {
                return;
            }
            
            var existing = getBlock(newX, newY, newZ);
            if (existing === BLOCKS.AIR || NON_SOLID_BLOCKS.indexOf(existing) !== -1) {
                playPlaceSound();
                setBlock(newX, newY, newZ, blockType);
                updateBlockMesh(newX, newY, newZ);
            }
        }
        
        // ==================== プレイヤー物理 ====================
        function isInWater() {
            var x = Math.floor(camera.position.x);
            var y = Math.floor(camera.position.y - 0.5);
            var z = Math.floor(camera.position.z);
            return getBlock(x, y, z) === BLOCKS.WATER;
        }
        
        function getPlayerGroundY() {
            var x = Math.floor(camera.position.x);
            var z = Math.floor(camera.position.z);
            
            for (var y = Math.floor(camera.position.y); y >= 0; y--) {
                var block = getBlock(x, y, z);
                if (block !== BLOCKS.AIR && NON_SOLID_BLOCKS.indexOf(block) === -1) {
                    return y + 1;
                }
            }
            return 0;
        }
        
        function checkCollision(x, y, z) {
            var margin = 0.3;
            var height = 1.62;
            
            var minX = Math.floor(x - margin);
            var maxX = Math.floor(x + margin);
            var minY = Math.floor(y - height);
            var maxY = Math.floor(y + 0.1);
            var minZ = Math.floor(z - margin);
            var maxZ = Math.floor(z + margin);
            
            for (var bx = minX; bx <= maxX; bx++) {
                for (var by = minY; by <= maxY; by++) {
                    for (var bz = minZ; bz <= maxZ; bz++) {
                        var block = getBlock(bx, by, bz);
                        if (block !== BLOCKS.AIR && NON_SOLID_BLOCKS.indexOf(block) === -1) {
                            return true;
                        }
                    }
                }
            }
            
            return false;
        }
        
        // 安全なスポーン地点を探す（地上で空間が確保されている場所）
        function findSafeSpawnY(x, z) {
            // 上から下に向かって地面を探す
            for (var y = WORLD_SIZE_Y - 3; y >= WATER_LEVEL; y--) {
                var blockBelow = getBlock(Math.floor(x), y - 1, Math.floor(z));
                var blockAt = getBlock(Math.floor(x), y, Math.floor(z));
                var blockAbove = getBlock(Math.floor(x), y + 1, Math.floor(z));
                
                // 足元がソリッドで、頭と体の位置が空気またはパススルー可能
                var isSolidBelow = blockBelow !== BLOCKS.AIR && NON_SOLID_BLOCKS.indexOf(blockBelow) === -1;
                var isPassableAt = blockAt === BLOCKS.AIR || NON_SOLID_BLOCKS.indexOf(blockAt) !== -1;
                var isPassableAbove = blockAbove === BLOCKS.AIR || NON_SOLID_BLOCKS.indexOf(blockAbove) !== -1;
                
                // 水上には立たない
                if (blockBelow === BLOCKS.WATER) continue;
                
                if (isSolidBelow && isPassableAt && isPassableAbove) {
                    return y + 1.62; // プレイヤーの目の高さ
                }
            }
            return -1; // 見つからなかった
        }
        
        function updatePlayer(delta) {
            var inWater = isInWater();
            var moveSpeed = isFlying ? 12 : (inWater ? 2.5 : 6);
            
            var forward = new THREE.Vector3();
            camera.getWorldDirection(forward);
            forward.y = 0;
            forward.normalize();
            
            var right = new THREE.Vector3();
            right.crossVectors(forward, new THREE.Vector3(0, 1, 0));
            
            var direction = new THREE.Vector3();
            if (keys.forward) direction.add(forward);
            if (keys.backward) direction.sub(forward);
            if (keys.right) direction.add(right);
            if (keys.left) direction.sub(right);
            
            if (direction.length() > 0) {
                direction.normalize();
                velocity.x = direction.x * moveSpeed;
                velocity.z = direction.z * moveSpeed;
            } else {
                velocity.x *= 0.8;
                velocity.z *= 0.8;
            }
            
            if (isFlying) {
                if (keys.jump) {
                    velocity.y = 6;
                } else {
                    velocity.y *= 0.9;
                }
            } else {
                if (inWater) {
                    velocity.y -= 4 * delta;
                    if (keys.jump) velocity.y = 2.5;
                    velocity.y = Math.max(velocity.y, -1.5);
                } else {
                    velocity.y -= 20 * delta;
                    
                    var groundY = getPlayerGroundY();
                    if (camera.position.y - 1.62 <= groundY) {
                        camera.position.y = groundY + 1.62;
                        velocity.y = 0;
                        if (keys.jump) velocity.y = 7;
                    }
                }
            }
            
            var newX = camera.position.x + velocity.x * delta;
            var newY = camera.position.y + velocity.y * delta;
            var newZ = camera.position.z + velocity.z * delta;
            
            // 飛行モード時は衝突判定を緩和
            if (isFlying) {
                camera.position.x = newX;
                camera.position.y = newY;
                camera.position.z = newZ;
            } else {
                if (!checkCollision(newX, camera.position.y, camera.position.z)) {
                    camera.position.x = newX;
                } else {
                    velocity.x = 0;
                }
                
                if (!checkCollision(camera.position.x, newY, camera.position.z)) {
                    camera.position.y = newY;
                } else {
                    velocity.y = 0;
                }
                
                if (!checkCollision(camera.position.x, camera.position.y, newZ)) {
                    camera.position.z = newZ;
                } else {
                    velocity.z = 0;
                }
            }
            
            camera.position.x = Math.max(1, Math.min(WORLD_SIZE_X - 1, camera.position.x));
            camera.position.z = Math.max(1, Math.min(WORLD_SIZE_Z - 1, camera.position.z));
            camera.position.y = Math.max(2, Math.min(WORLD_SIZE_Y - 1, camera.position.y));
            
            document.getElementById('coords').textContent = 
                Math.floor(camera.position.x) + ', ' + Math.floor(camera.position.y) + ', ' + Math.floor(camera.position.z);
            document.getElementById('mode').textContent = 
                isFlying ? '飛行' : (inWater ? '水中' : '通常');
            
            // デバッグ: 入力状態を表示
            var inputState = '';
            if (keys.forward) inputState += 'W';
            if (keys.backward) inputState += 'S';
            if (keys.left) inputState += 'A';
            if (keys.right) inputState += 'D';
            if (keys.jump) inputState += 'J';
            document.getElementById('debug-info').textContent = 'Input:' + (inputState || 'none') + ' V:' + velocity.x.toFixed(1) + ',' + velocity.z.toFixed(1);
        }
        
        // ==================== 入力処理 ====================
        function updateCameraRotation() {
            camera.rotation.order = 'YXZ';
            camera.rotation.y = yaw;
            camera.rotation.x = pitch;
        }
        
        function initControls() {
            // キーボード
            document.addEventListener('keydown', function(e) {
                if (!isPlaying) return;
                
                switch (e.code) {
                    case 'KeyW': keys.forward = true; break;
                    case 'KeyS': keys.backward = true; break;
                    case 'KeyA': keys.left = true; break;
                    case 'KeyD': keys.right = true; break;
                    case 'Space': keys.jump = true; e.preventDefault(); break;
                    case 'KeyF': isFlying = !isFlying; velocity.y = 0; break;
                    case 'Digit1': case 'Digit2': case 'Digit3': case 'Digit4': case 'Digit5':
                    case 'Digit6': case 'Digit7': case 'Digit8': case 'Digit9':
                        selectSlot(parseInt(e.code.replace('Digit', '')) - 1);
                        break;
                }
            });
            
            document.addEventListener('keyup', function(e) {
                switch (e.code) {
                    case 'KeyW': keys.forward = false; break;
                    case 'KeyS': keys.backward = false; break;
                    case 'KeyA': keys.left = false; break;
                    case 'KeyD': keys.right = false; break;
                    case 'Space': keys.jump = false; break;
                }
            });
            
            // PC用マウス
            document.addEventListener('mousemove', function(e) {
                if (!isPlaying || isMobile) return;
                if (document.pointerLockElement !== renderer.domElement) return;
                
                yaw -= e.movementX * 0.002;
                pitch -= e.movementY * 0.002;
                pitch = Math.max(-Math.PI / 2 + 0.1, Math.min(Math.PI / 2 - 0.1, pitch));
                updateCameraRotation();
            });
            
            document.addEventListener('mousedown', function(e) {
                if (!isPlaying || isMobile) return;
                if (document.pointerLockElement !== renderer.domElement) return;
                
                if (e.button === 0) breakBlock();
                else if (e.button === 2) placeBlock();
            });
            
            document.addEventListener('contextmenu', function(e) { e.preventDefault(); });
            
            // モバイル用タッチ
            var joystickArea = document.getElementById('joystick-area');
            var joystickThumb = document.getElementById('joystick-thumb');
            
            if (joystickArea) {
                joystickArea.addEventListener('touchstart', function(e) {
                    e.preventDefault();
                    joystickActive = true;
                    var touch = e.touches[0];
                    var rect = joystickArea.getBoundingClientRect();
                    joystickStart.x = rect.left + rect.width / 2;
                    joystickStart.y = rect.top + rect.height / 2;
                });
                
                joystickArea.addEventListener('touchmove', function(e) {
                    if (!joystickActive) return;
                    e.preventDefault();
                    var touch = e.touches[0];
                    var dx = touch.clientX - joystickStart.x;
                    var dy = touch.clientY - joystickStart.y;
                    var dist = Math.sqrt(dx * dx + dy * dy);
                    var maxDist = 40;
                    
                    if (dist > maxDist) {
                        dx = dx / dist * maxDist;
                        dy = dy / dist * maxDist;
                    }
                    
                    joystickThumb.style.transform = 'translate(calc(-50% + ' + dx + 'px), calc(-50% + ' + dy + 'px))';
                    
                    // 感度を下げて判定（5ピクセルで反応）
                    keys.forward = dy < -5;
                    keys.backward = dy > 5;
                    keys.left = dx < -5;
                    keys.right = dx > 5;
                });
                
                joystickArea.addEventListener('touchend', function(e) {
                    joystickActive = false;
                    joystickThumb.style.transform = 'translate(-50%, -50%)';
                    keys.forward = false;
                    keys.backward = false;
                    keys.left = false;
                    keys.right = false;
                });
            }
            
            // カメラ操作（右側の画面タッチ）
            renderer.domElement.addEventListener('touchstart', function(e) {
                if (!isPlaying) return;
                for (var i = 0; i < e.touches.length; i++) {
                    var touch = e.touches[i];
                    if (touch.clientX > window.innerWidth * 0.4 && cameraTouch === null) {
                        cameraTouch = {
                            id: touch.identifier,
                            x: touch.clientX,
                            y: touch.clientY
                        };
                    }
                }
            });
            
            renderer.domElement.addEventListener('touchmove', function(e) {
                if (!isPlaying || cameraTouch === null) return;
                for (var i = 0; i < e.touches.length; i++) {
                    var touch = e.touches[i];
                    if (touch.identifier === cameraTouch.id) {
                        var dx = touch.clientX - cameraTouch.x;
                        var dy = touch.clientY - cameraTouch.y;
                        
                        yaw -= dx * 0.005;
                        pitch -= dy * 0.005;
                        pitch = Math.max(-Math.PI / 2 + 0.1, Math.min(Math.PI / 2 - 0.1, pitch));
                        updateCameraRotation();
                        
                        cameraTouch.x = touch.clientX;
                        cameraTouch.y = touch.clientY;
                    }
                }
            });
            
            renderer.domElement.addEventListener('touchend', function(e) {
                var found = false;
                for (var i = 0; i < e.touches.length; i++) {
                    if (e.touches[i].identifier === cameraTouch.id) found = true;
                }
                if (!found) cameraTouch = null;
            });
            
            // モバイルボタン
            var breakBtn = document.getElementById('break-btn');
            var placeBtn = document.getElementById('place-btn');
            var jumpBtn = document.getElementById('jump-btn');
            var flyBtn = document.getElementById('fly-btn');
            
            if (breakBtn) breakBtn.addEventListener('touchstart', function(e) { e.preventDefault(); breakBlock(); });
            if (placeBtn) placeBtn.addEventListener('touchstart', function(e) { e.preventDefault(); placeBlock(); });
            if (jumpBtn) {
                jumpBtn.addEventListener('touchstart', function(e) { e.preventDefault(); keys.jump = true; });
                jumpBtn.addEventListener('touchend', function(e) { keys.jump = false; });
            }
            if (flyBtn) flyBtn.addEventListener('touchstart', function(e) { e.preventDefault(); isFlying = !isFlying; velocity.y = 0; });
        }
        
        // ==================== 初期化 ====================
        function init() {
            var loadingProgress = document.getElementById('loading-progress');
            var loadingText = document.getElementById('loading-text');
            
            function setProgress(progress, text) {
                loadingProgress.style.width = (progress * 100) + '%';
                if (text) loadingText.textContent = text;
            }
            
            // Three.js初期化
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x87CEEB);
            scene.fog = new THREE.Fog(0x87CEEB, 15, 30);
            
            camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 35);
            
            renderer = new THREE.WebGLRenderer({ antialias: false });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            document.getElementById('game-container').appendChild(renderer.domElement);
            
            var ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);
            
            var directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(50, 100, 50);
            scene.add(directionalLight);
            
            setProgress(0.05, 'ノイズ初期化中...');
            initNoise();
            
            setTimeout(function() {
                setProgress(0.1, 'テクスチャ生成中...');
                initTextures();
                initMaterials();
                
                setTimeout(function() {
                    setProgress(0.15, '地形生成中...');
                    generateTerrain(setProgress);
                    
                    setTimeout(function() {
                        setProgress(0.45, '木を生成中...');
                        generateTrees(setProgress);
                        
                        setTimeout(function() {
                            setProgress(0.65, '植物を生成中...');
                            generateVegetation(setProgress);
                            
                            setTimeout(function() {
                                setProgress(0.72, '構造物を生成中...');
                                generateStructures(setProgress);
                                
                                setTimeout(function() {
                                    setProgress(0.78, 'メッシュ構築中...');
                                    updateVisibleBlocks(setProgress);
                                    
                                    setTimeout(function() {
                                        setProgress(0.96, 'Mob配置中...');
                                        spawnMobs();
                                        
                                        // 安全なスポーン地点を探す
                                        var spawnX = WORLD_SIZE_X / 2;
                                        var spawnZ = WORLD_SIZE_Z / 2;
                                        var spawnY = findSafeSpawnY(spawnX, spawnZ);
                                        
                                        // もし安全な場所が見つからなければ、周囲を探す
                                        if (spawnY < 0) {
                                            for (var r = 1; r < 20; r++) {
                                                for (var angle = 0; angle < 8; angle++) {
                                                    var testX = Math.floor(spawnX + Math.cos(angle * Math.PI / 4) * r * 3);
                                                    var testZ = Math.floor(spawnZ + Math.sin(angle * Math.PI / 4) * r * 3);
                                                    testX = Math.max(5, Math.min(WORLD_SIZE_X - 5, testX));
                                                    testZ = Math.max(5, Math.min(WORLD_SIZE_Z - 5, testZ));
                                                    var testY = findSafeSpawnY(testX, testZ);
                                                    if (testY > 0) {
                                                        spawnX = testX;
                                                        spawnZ = testZ;
                                                        spawnY = testY;
                                                        break;
                                                    }
                                                }
                                                if (spawnY > 0) break;
                                            }
                                        }
                                        
                                        // 最終的なフォールバック
                                        if (spawnY < 0) {
                                            spawnY = GROUND_LEVEL + 10;
                                        }
                                        
                                        camera.position.set(spawnX, spawnY, spawnZ);
                                        
                                        // 安全のため飛行モードで開始
                                        isFlying = true;
                                        
                                        initHotbar();
                                        initControls();
                                        initAudio();
                                        
                                        setProgress(1, '完了！');
                                        
                                        setTimeout(function() {
                                            document.getElementById('loading').style.display = 'none';
                                            animate();
                                        }, 500);
                                    }, 50);
                                }, 50);
                            }, 50);
                        }, 50);
                    }, 50);
                }, 50);
            }, 50);
            
            window.addEventListener('resize', function() {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        }
        
        window.startGame = function() {
            isPlaying = true;
            document.getElementById('instructions').style.display = 'none';
            
            if (!isMobile) {
                renderer.domElement.requestPointerLock();
            }
            
            if (audioContext && audioContext.state === 'suspended') {
                audioContext.resume();
            }
        };
        
        document.getElementById('start-btn').onclick = window.startGame;
        
        // ==================== ゲームループ ====================
        function animate() {
            requestAnimationFrame(animate);
            
            var now = performance.now();
            var delta = Math.min((now - lastTime) / 1000, 0.1);
            lastTime = now;
            
            frameCount++;
            if (frameCount % 30 === 0) {
                fps = Math.round(1 / delta);
                document.getElementById('fps').textContent = fps;
            }
            
            if (isPlaying) {
                updatePlayer(delta);
            }
            
            for (var i = 0; i < mobs.length; i++) {
                mobs[i].update(delta);
            }
            
            for (var i = particles.length - 1; i >= 0; i--) {
                if (!particles[i].update(delta)) {
                    particles[i].destroy();
                    particles.splice(i, 1);
                }
            }
            
            renderer.render(scene, camera);
        }
        
        // 起動
        init();
    })();
    </script>
</body>
</html>
